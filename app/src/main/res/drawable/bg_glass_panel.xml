<?xml version="1.0" encoding="utf-8"?>
<!--
  面板的底色层：半透明的磨砂白（深色主题下是磨砂黑）+ 一道很细的描边。

  真的"身后模糊 + 折射"是 ReaderChrome 拿屏幕截图（PixelCopy）做出来的，
  这一层只是保证两件事：
  1. 拿不到截图 / 系统不支持 RenderEffect 时，面板仍然是块半透明的磨砂玻璃；
  2. 截图上面再压一点底色，面板上的图标文字才够清楚，不耽误看内容。
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/panel_glass" />
    <corners android:radius="18dp" />
    <stroke
        android:width="1dp"
        android:color="@color/panel_glass_stroke" />
</shape>
