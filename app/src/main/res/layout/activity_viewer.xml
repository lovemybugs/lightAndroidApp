<?xml version="1.0" encoding="utf-8"?>
<!--
  阅读器。

  正文是满屏铺开的：这里**没有**顶栏。以前用 AppBarLayout + MaterialToolbar
  占着顶部一条，那一条既要垫状态栏高度、又要跟着"显示 / 隐藏"来回改内边距，
  系统栏高度被反复叠加，顶部白边就一次比一次厚，最后糊掉半屏。

  现在工具栏改成从屏幕边缘拉出来的浮层小面板（@id/tool_panel），平时只留一个小把手
  （@id/tool_handle）：把手能拖到任意一条边，拖到哪儿下次就从哪儿拉出来，
  点一下正文还能让它滑出去 / 滑回来。两者都浮在 WebView 上层、用平移来动，
  不占布局、不碰任何 padding，白边从结构上就不可能再出现。
-->
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- ================= 正文（满屏） ================= -->
    <FrameLayout
        android:id="@+id/content_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground" />

        <ProgressBar
            android:id="@+id/progress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="top"
            android:max="100"
            android:visibility="gone" />

        <TextView
            android:id="@+id/hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:maxWidth="260dp"
            android:gravity="center"
            android:background="@drawable/bg_hint"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:text="@string/handle_hint"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/error_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="?android:attr/colorBackground"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="32dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/load_failed"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/error_retry"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/retry" />
        </LinearLayout>

        <!-- ============ 拉出来的工具面板：液态玻璃 ============ -->
        <!--
          宽度固定 128dp，只够并排两个按钮 —— 竖向细长的一条。
          高度由 ReaderChrome 按屏幕高度算好后写进来（面板里的子视图都用
          match_parent，wrap_content 的父容器会被它们撑开，所以高度必须定死）。
        -->
        <FrameLayout
            android:id="@+id/tool_panel"
            android:layout_width="128dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start|top"
            android:clickable="true"
            android:focusable="true">

            <!-- 面板背后那一块的屏幕截图（PixelCopy），模糊 + 折射都作用在它上面 -->
            <ImageView
                android:id="@+id/panel_backdrop"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="matrix" />

            <!-- 半透明底色 + 描边；也是拿不到截图时的兜底 -->
            <View
                android:id="@+id/panel_scrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_panel" />

            <!-- 慢慢来回晃的一道高光：液态玻璃的"流动感" -->
            <View
                android:id="@+id/panel_gloss"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_glass_gloss" />

            <LinearLayout
                android:id="@+id/panel_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="8dp">

                <TextView
                    android:id="@+id/panel_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="4dp"
                    android:ellipsize="end"
                    android:maxWidth="112dp"
                    android:paddingStart="4dp"
                    android:paddingEnd="4dp"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- 按钮行由 ReaderChrome 按 2 列铺进来 -->
                <LinearLayout
                    android:id="@+id/panel_actions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </FrameLayout>

        <!--
          侧边的小把手。宽高、圆角方向、箭头朝向都由 ReaderChrome 按所在的那条边来定：
          拖到上/下边它就横过来。
        -->
        <FrameLayout
            android:id="@+id/tool_handle"
            android:layout_width="22dp"
            android:layout_height="64dp"
            android:layout_gravity="start|top"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/handle_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="5dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_chevron"
                app:tint="?attr/colorOnSurfaceVariant" />
        </FrameLayout>
    </FrameLayout>

    <!-- ================= 侧边目录树 ================= -->
    <LinearLayout
        android:layout_width="304dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="?attr/colorSurface"
        android:elevation="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/drawer_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/colorSurfaceContainerHigh"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="20dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/drawer_header_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/drawer_header_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawer_back"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/back_to_library" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawer_favorites"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/favorites" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/drawer_recent"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minWidth="0dp"
                    android:text="@string/recent" />
            </LinearLayout>
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/drawer_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"
            android:scrollbars="vertical" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
